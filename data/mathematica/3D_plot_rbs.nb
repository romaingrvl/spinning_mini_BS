Cell[BoxData[{
 RowBox[{"Ttt", "=", 
  RowBox[{"Interpolation", "[", 
   RowBox[{"dataTtt", ",", 
    RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ttt\[Rho]z", "[", 
   RowBox[{"\[Rho]_", ",", "z_"}], "]"}], ":=", 
  RowBox[{"Ttt", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "^", "2"}], "+", 
       RowBox[{"z", "^", "2"}]}], "]"}], 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"\[Rho]", "^", "2"}], "+", 
        RowBox[{"z", "^", "2"}]}], "]"}], "+", "c"}]], ",", 
    RowBox[{"ArcTan", "[", 
     RowBox[{
      RowBox[{"Abs", "[", "z", "]"}], ",", "\[Rho]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tttxyz", "[", 
