  "In[111]:=",ExpressionUUID->"5e310bb5-be05-4383-99e9-cc2b24749035"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Lz", "=", 
  RowBox[{"2", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"dl", "[", "x", "]"}], 
      FractionBox["c", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "x"}], ")"}], "^", "2"}]]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "xmin", ",", "zcd"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.970658420032391*^9, 3.9706585100649643`*^9}},
 CellLabel->"In[81]:=",ExpressionUUID->"b721acc5-9f52-4a1b-9b5e-df782c6b6889"],

